    "Device authentication is unavailable. Disable the lock in system settings or configure a passcode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gerät-Authentifizierung ist nicht verfügbar. Deaktivieren Sie den Schloss in den Systemeinstellungen oder konfigurieren Sie einen Passwort-Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autenticación de dispositivo no está disponible. Desactive el bloqueo en los ajustes del sistema o configure un código de acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'authentification du dispositif est indisponible. Désactivez le verrouillage dans les paramètres du système ou configurez un code d'accès."
          }
        }
      }
    },
    "Diagnostics contain timestamps and typed event codes only—never names, contact details, notes, or report text.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Diagnosen enthalten nur Zeitstempel und typische Ereignis-Codes – niemals Namen, Kontaktdaten, Notizen oder Text von Berichten."
