        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diagnósticos contienen solo fechas y códigos de eventos tipo — nunca nombres, detalles de contacto, notas o texto de informes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les diagnostics contiennent uniquement des horodatages et des codes d'événements type — jamais des noms, des détails de contact, des notes ou du texte des rapports."
