    "Before permanent deletion, DogCoach Studio shows dependent records and recommends an export. Business history can be archived instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor die dauerhafte Löschung, zeigt DogCoach Studio abhängige Aufzeichnungen und empfiehlt eine Ausgabe. Geschäftsgeschichte kann archiviert werden anstatt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de la eliminación permanente, DogCoach Studio muestra registros dependientes y recomienda una exportación. Historia empresarial puede ser archivada en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant la suppression définitive, DogCoach Studio affiche les enregistrements dépendants et recommande une exportation. Histoire commerciale peut être archivée à la place."
          }
        }
      }
    },
